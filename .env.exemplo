# Copie este arquivo para .env e cole o token que o @BotFather te deu.
# O .env está no .gitignore, então o token de verdade nunca vai pro GitHub.
TELEGRAM_TOKEN=cole-seu-token-aqui

# Opcional: deixa o bot só para estas pessoas (IDs do Telegram separados por vírgula).
# Cada pessoa descobre o seu ID mandando /meuid para o bot. Vazio = aberto para todos.
USUARIOS_PERMITIDOS=

# Opcional: chave gratuita da AwesomeAPI (cotações), criada em awesomeapi.com.br.
# Sem ela, a API limita as consultas por endereço; em servidores na nuvem costuma recusar logo.
AWESOMEAPI_TOKEN=

# Opcional: liga o /gasto, que lança gastos no Spendwise (controle de gastos).
# Crie a chave no site do Spendwise, em Sua conta > Chaves de acesso (ela aparece uma vez só).
# Por segurança, o /gasto só funciona com USUARIOS_PERMITIDOS preenchido.
SPENDWISE_CHAVE=
# SPENDWISE_URL=https://controle-gastos-lakes777.vercel.app

# Opcional: liga o /prazos, que lê as provas e trabalhos do Coursebook (painel de estudos).
# Crie a chave no site do Coursebook, na tela Dados > Chaves de acesso (ela aparece uma vez só).
# Por segurança, o /prazos só funciona com USUARIOS_PERMITIDOS preenchido.
COURSEBOOK_CHAVE=
# COURSEBOOK_URL=https://painel-estudos-cyan.vercel.app
