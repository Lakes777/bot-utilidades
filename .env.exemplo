# Copie este arquivo para .env e cole o token que o @BotFather te deu.
# O .env está no .gitignore, então o token de verdade nunca vai pro GitHub.
TELEGRAM_TOKEN=cole-seu-token-aqui

# Opcional: deixa o bot só para estas pessoas (IDs do Telegram separados por vírgula).
# Cada pessoa descobre o seu ID mandando /meuid para o bot. Vazio = aberto para todos.
USUARIOS_PERMITIDOS=

# Opcional: chave gratuita da AwesomeAPI (cotações), criada em awesomeapi.com.br.
# Sem ela, a API limita as consultas por endereço; em servidores na nuvem costuma recusar logo.
AWESOMEAPI_TOKEN=
